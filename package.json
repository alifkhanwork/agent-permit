{
  "name": "@siliconvalleyglobal/agent-permit",
  "version": "0.1.1",
  "description": "Shared, consistent permission-prompt and policy layer for AI coding agent tools",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "agent-permit": "bin/agent-permit.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npx tsup",
    "dev": "npx tsup --watch",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "typecheck": "npx -p typescript tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifkhanwork/agent-permit.git"
  },
  "homepage": "https://github.com/alifkhanwork/agent-permit#readme",
  "bugs": {
    "url": "https://github.com/alifkhanwork/agent-permit/issues"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "permissions",
    "permission-prompt",
    "cli-prompt",
    "security",
    "guardrails",
    "middleware",
    "approval",
    "confirmation",
    "safety",
    "sandbox",
    "policy",
    "access-control",
    "rbac",
    "human-in-the-loop",
    "audit-log",
    "shell-exec",
    "developer-tools",
    "devtools",
    "llm",
    "llm-tools",
    "ai-coding-assistant",
    "cursor",
    "claude-code",
    "cline",
    "codex",
    "windsurf",
    "terminal-ui"
  ],
  "author": "SVG Team",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
